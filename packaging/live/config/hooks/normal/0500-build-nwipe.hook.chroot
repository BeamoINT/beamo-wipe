#!/bin/sh
set -eu
umask 077
# Pin nwipe v0.42 by tag AND commit. Tags can move; the SHA cannot.
# No distro fallback — bookworm's nwipe is not 0.42.
NWIPE_TAG=v0.42
NWIPE_COMMIT=6082bde060091e66365d852a1877f2ee80c67105
export DEBIAN_FRONTEND=noninteractive
WORKDIR="$(mktemp -d /tmp/beamo-wipe-nwipe.XXXXXX)"
trap 'rm -rf -- "$WORKDIR"' EXIT HUP INT TERM

run_logged() {
  log_file="$1"
  shift
  if "$@" >"$log_file" 2>&1; then
    return 0
  fi
  rc=$?
  echo "ERROR: command failed (exit $rc): $1" >&2
  tail -n 50 "$log_file" >&2 || true
  return "$rc"
}

run_logged "$WORKDIR/apt-update.log" apt-get update -o Acquire::Retries=3 || {
  echo "Next: check mirror https://deb.debian.org and retry the build." >&2
  exit 1
}
run_logged "$WORKDIR/apt-install.log" apt-get install -y --no-install-recommends \
  build-essential \
  automake \
  autoconf \
  git \
  pkg-config \
  libncurses-dev \
  libparted-dev \
  libconfig-dev \
  ca-certificates || {
  echo "Next: check the signed Debian mirror and retry the build." >&2
  exit 1
}

mkdir -p /usr/share/doc/beamo-wipe
# Ignore chroot/host gitconfig so url.insteadOf cannot redirect this clone.
export GIT_CONFIG_NOSYSTEM=1
export GIT_CONFIG_GLOBAL=/dev/null
export GIT_CONFIG_SYSTEM=/dev/null
# QEMU user-mode amd64 git+GnuTLS often drops the pack once; retry.
# Log each attempt with timestamp, exit code, and tail for maintainer triage.
n=0
clone_log="$WORKDIR/nwipe-clone.log"
: > "$clone_log"
while :; do
  rm -rf -- "$WORKDIR/nwipe"
  ts="$(date -u +%FT%TZ 2>/dev/null || date)"
  if git clone --depth 1 --branch "$NWIPE_TAG" \
    https://github.com/martijnvanbrummelen/nwipe.git "$WORKDIR/nwipe" >>"$clone_log" 2>&1; then
    echo "[$ts] git clone succeeded (attempt $((n+1))/5)" >>"$clone_log"
    break
  else
    rc=$?
  fi
  n=$((n + 1))
  echo "[$ts] W: git clone nwipe failed rc=$rc, retry $n/5 (tag=$NWIPE_TAG commit=$NWIPE_COMMIT)." >>"$clone_log"
  if [ "$n" -ge 5 ]; then
    echo "ERROR: git clone nwipe failed after $n attempts (tag=$NWIPE_TAG commit=$NWIPE_COMMIT rc=$rc). Last 40 lines:" >&2
    tail -n 40 "$clone_log" >&2 || true
    echo "Next: verify network, retry ./scripts/build-iso.sh, or check https://github.com/martijnvanbrummelen/nwipe" >&2
    exit 1
  fi
  sleep $((n * 8))
done
cd "$WORKDIR/nwipe"
got="$(git rev-parse HEAD)"
if [ "$got" != "$NWIPE_COMMIT" ]; then
  echo "ERROR: nwipe commit $got does not match pinned $NWIPE_COMMIT" >&2
  exit 1
fi
if [ -x ./autogen.sh ]; then
  run_logged "$WORKDIR/nwipe-autogen.log" ./autogen.sh || exit 1
fi
run_logged "$WORKDIR/nwipe-configure.log" ./configure || exit 1
jobs="$(nproc 2>/dev/null || printf '2\n')"
run_logged "$WORKDIR/nwipe-make.log" make -j"$jobs" || exit 1
run_logged "$WORKDIR/nwipe-install.log" make install || exit 1
cd /
rm -rf -- "$WORKDIR/nwipe"
# Keep the engine off PATH so a second TTY cannot skip the wizard gates.
install -d -m 0755 /usr/lib/beamo-wipe
if [ ! -x /usr/local/bin/nwipe ]; then
  echo "ERROR: nwipe did not install to /usr/local/bin/nwipe" >&2
  exit 1
fi
mv /usr/local/bin/nwipe /usr/lib/beamo-wipe/nwipe
chmod 0755 /usr/lib/beamo-wipe/nwipe
if [ -e /usr/bin/nwipe ] || [ -e /usr/local/bin/nwipe ] \
  || [ -e /usr/sbin/nwipe ] || [ -e /usr/local/sbin/nwipe ]; then
  echo "ERROR: nwipe is still on PATH" >&2
  exit 1
fi
cat > /usr/local/bin/nwipe << 'EOF'
#!/bin/sh
echo "nwipe is not run directly. Boot Beamo Wipe and use the screens." >&2
exit 2
EOF
chmod 0755 /usr/local/bin/nwipe
/usr/lib/beamo-wipe/nwipe -V > /usr/share/doc/beamo-wipe/NWIPE_VERSION 2>&1
# Anchored pinned-version match (mirrors NWIPE_VERSION_LINE_RE in
# src/beamo_wipe/nwipe_runner.py): a bare "0.42" substring also matches
# 0.420 / 10.42 / help text mentioning the pin.
if ! grep -qiE '^nwipe version 0\.42([[:space:]]|$)' /usr/share/doc/beamo-wipe/NWIPE_VERSION; then
  echo "ERROR: installed nwipe is not v0.42" >&2
  cat /usr/share/doc/beamo-wipe/NWIPE_VERSION >&2
  exit 1
fi

# Drop compilers and VCS from the shipped image. Fail the build if they remain.
apt-get purge -y \
  build-essential \
  automake \
  autoconf \
  git \
  pkg-config \
  libncurses-dev \
  libparted-dev \
  libconfig-dev
apt-get autoremove -y --purge
# autoremove keeps any package still reachable through another installed
# package's Depends/Recommends, and what stays reachable depends on the exact
# chroot contents (x11-xserver-utils Depends: cpp anchors the C toolchain
# chain). The image contract is "no compiler toolchain", so purge whatever
# compiler packages actually remain instead of trusting the cascade.
# Deliberately not cpp: x11-xserver-utils needs it, and a bare preprocessor
# cannot compile (cc1 lives in the gcc-12 package). The patterns never match
# the runtime libgcc-s1/libstdc++6 or gcc-12-base.
leftovers="$(dpkg-query -W -f='${binary:Package}\n' 2>/dev/null | grep -E '^(gcc|g\+\+)(-[0-9]+)?(:[a-z0-9-]+)?$|^lib(gcc|stdc\+\+)-[0-9]+-dev(:[a-z0-9-]+)?$' || true)"
if [ -n "$leftovers" ]; then
  # dpkg-query output is newline-delimited and the strict package-name regex
  # above excludes whitespace and glob metacharacters.
  # shellcheck disable=SC2086
  set -- $leftovers
  for package in "$@"; do
    case "$package" in
      gcc|g++|gcc-[0-9]*|g++-[0-9]*|libgcc-[0-9]*-dev|libstdc++-[0-9]*-dev) ;;
      *) echo "ERROR: unsafe compiler package name" >&2; exit 1 ;;
    esac
  done
  apt-get purge -y -- "$@"
  apt-get autoremove -y --purge
fi
apt-get install -y --no-install-recommends libncurses6 libparted2 libconfig9
# Clear the shell's command cache: this hook ran git/gcc earlier, and dash
# would otherwise answer command -v from the stale cache after the purge.
hash -r 2>/dev/null || true
if command -v gcc >/dev/null 2>&1; then
  echo "ERROR: gcc is still present in the live image" >&2
  exit 1
fi
if command -v git >/dev/null 2>&1; then
  echo "ERROR: git is still present in the live image" >&2
  exit 1
fi

# No network by default. Every getty would bypass the confirm gates; tty1 is
# owned directly by the systemd kiosk service, never an autologin shell.
# live-build's chroot is not PID 1, so `systemctl mask` is often a no-op.
# Write the mask units as symlinks; keep systemctl as a best-effort extra.
systemctl mask NetworkManager.service wpa_supplicant.service \
  systemd-networkd.service systemd-networkd.socket systemd-timesyncd.service \
  ssh.service ssh.socket sshd.service sshd.socket || true
for tty in tty1 tty2 tty3 tty4 tty5 tty6; do
  ln -sfn /dev/null "/etc/systemd/system/getty@${tty}.service"
  systemctl mask "getty@${tty}.service" || true
done
ln -sfn /dev/null /etc/systemd/system/serial-getty@ttyS0.service
systemctl mask serial-getty@ttyS0.service || true
# Debian live-config 0140-xinit writes an infinite `startx` loop on tty1
# (sourced from /etc/profile.d before ~/.profile). Remove the component.
rm -f /lib/live/config/0140-xinit
mkdir -p /etc/systemd/logind.conf.d
cat > /etc/systemd/logind.conf.d/beamo-kiosk.conf << 'EOF'
[Login]
NAutoVTs=1
ReserveVT=1
EOF
chmod 755 /usr/local/bin/beamo-wipe
chmod 755 /usr/local/sbin/beamo-wipe-kiosk
mkdir -p /etc/systemd/system/multi-user.target.wants
ln -sfn /etc/systemd/system/beamo-wipe-kiosk.service \
  /etc/systemd/system/multi-user.target.wants/beamo-wipe-kiosk.service
# Boot assets and the pinned engine are immutable to non-root users. rsync from
# a macOS bind mount can otherwise preserve host UID/GID values in the chroot.
chown -R root:root /usr/lib/beamo-wipe /usr/local/bin/beamo-wipe \
  /usr/local/sbin/beamo-wipe-kiosk /etc/systemd/system/beamo-wipe-kiosk.service \
  /usr/share/beamo-wipe /usr/share/doc/beamo-wipe
find /usr/lib/beamo-wipe /usr/share/beamo-wipe /usr/share/doc/beamo-wipe \
  -type d -exec chmod 0755 {} +
find /usr/lib/beamo-wipe /usr/share/beamo-wipe /usr/share/doc/beamo-wipe \
  -type f -exec chmod 0644 {} +
chmod 0755 /usr/lib/beamo-wipe/nwipe /usr/local/bin/beamo-wipe \
  /usr/local/sbin/beamo-wipe-kiosk
if find /usr/lib/beamo-wipe /usr/local/bin/beamo-wipe \
  /usr/local/sbin/beamo-wipe-kiosk /usr/share/beamo-wipe \
  \( ! -user root -o ! -group root -o -perm /022 \) -print | grep -q .; then
  echo "ERROR: writable or non-root-owned boot asset" >&2
  exit 1
fi
