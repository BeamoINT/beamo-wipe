#!/bin/sh
set -e
# Pin nwipe v0.42 from upstream. No distro fallback — bookworm's nwipe is not 0.42.
mkdir -p /usr/share/doc/beamo-wipe
NWIPE_TAG=v0.42
git clone --depth 1 --branch "$NWIPE_TAG" https://github.com/martijnvanbrummelen/nwipe.git /tmp/nwipe
cd /tmp/nwipe
if [ -x ./autogen.sh ]; then
  ./autogen.sh
fi
./configure
make -j"$(nproc || echo 2)"
make install
cd /
rm -rf /tmp/nwipe
nwipe -V > /usr/share/doc/beamo-wipe/NWIPE_VERSION 2>&1
if ! grep -q "0.42" /usr/share/doc/beamo-wipe/NWIPE_VERSION; then
  echo "ERROR: installed nwipe is not v0.42" >&2
  cat /usr/share/doc/beamo-wipe/NWIPE_VERSION >&2
  exit 1
fi
# Drop compilers from the shipped image after the build.
apt-get purge -y build-essential automake autoconf git pkg-config || true
apt-get autoremove -y || true
# No network by default.
systemctl mask NetworkManager.service wpa_supplicant.service || true
chmod 755 /usr/local/bin/beamo-wipe || true
