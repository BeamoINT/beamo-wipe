[Unit]
Description=Beamo Wipe safety-gated kiosk
After=systemd-user-sessions.service
Conflicts=getty@tty1.service

[Service]
Type=simple
ExecStart=/usr/local/sbin/beamo-wipe-kiosk
# The supervisor owns its finite retry budget and stable recovery menu.
Restart=no
User=root
Group=root
WorkingDirectory=/
StandardInput=tty
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
# Preserve the recovery message even if terminal input closes.
TTYVTDisallocate=no
StandardOutput=tty
StandardError=tty
UMask=0077
NoNewPrivileges=yes
ProtectSystem=full
ProtectHome=yes
PrivateTmp=yes
PrivateMounts=yes
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
LockPersonality=yes

[Install]
WantedBy=multi-user.target
